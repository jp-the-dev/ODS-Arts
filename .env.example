APP_NAME=ODSArts
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Mail — REQUIRED before launch
# ─────────────────────────────────────────────────────────────────────────────
# MAIL_MAILER=log silently discards every order confirmation. Because the mail
# is queued, a broken setup fails inside the worker where nothing surfaces it:
# checkout still returns 201 and the customer simply never hears from us.
#
# Pick one and fill in its credentials:
#
#   Resend    MAIL_MAILER=resend    + RESEND_API_KEY=
#   Postmark  MAIL_MAILER=postmark  + POSTMARK_API_KEY=
#   SES       MAIL_MAILER=ses       + AWS_ACCESS_KEY_ID / SECRET / DEFAULT_REGION
#   Any SMTP  MAIL_MAILER=smtp      + MAIL_HOST / PORT / USERNAME / PASSWORD
#
# MAIL_FROM_ADDRESS must be on a domain you have verified with the provider, or
# messages will be rejected or land in spam.
#
# For LOCAL development, run a catch-all mail server instead of a real provider —
# it captures every message with a web UI to inspect the rendered HTML:
#
#   brew install mailpit && mailpit          # UI at http://localhost:8025
#   MAIL_MAILER=smtp  MAIL_HOST=127.0.0.1  MAIL_PORT=1025
#
# Verify it actually delivers:
#   php artisan odsarts:mail-test you@example.com
#   php artisan odsarts:mail-test you@example.com --queue   (also proves a worker)

# ─────────────────────────────────────────────────────────────────────────────
# Storefront
# ─────────────────────────────────────────────────────────────────────────────
# Where the Next.js app is served. Used for transactional email links and CORS.
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Payments — Razorpay (required to take money)
# ─────────────────────────────────────────────────────────────────────────────
# Without these, POST /orders/{ref}/pay returns 503 and nothing can be purchased.
# Called over HTTP; no vendor SDK is installed.
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Set this to the secret configured on the Razorpay webhook endpoint. The
# webhook is the authoritative payment signal — the browser may close before
# /verify runs — so leaving it unset means captured payments never confirm.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Shipping — Shiprocket (optional until fulfilment goes live)
# ─────────────────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=360002
SHIPROCKET_COURIER_MODE=auto_cheapest
SHIPROCKET_DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST
# ─────────────────────────────────────────────────────────────────────────────
# Verify all of the below with:  php artisan odsarts:preflight
# It exits non-zero while any blocker remains, so it can gate a deploy.
# APP_ENV=production
# APP_DEBUG=false          <- leaking stack traces and config otherwise
# APP_URL=https://api.odsarts.in
# FRONTEND_URL=https://odsarts.in
# MAIL_MAILER=<provider>   <- 'log' silently discards order confirmations
# MAIL_FROM_ADDRESS=hello@odsarts.in
# A queue worker MUST run — order confirmation mail and the Shiprocket job are
# queued:  php artisan queue:work --tries=3
# Then:    php artisan config:cache && php artisan route:cache
# Grant panel access:  php artisan user:admin you@example.com --grant
