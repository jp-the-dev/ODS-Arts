# Repo-wide. Stack-specific ignores live in backend/.gitignore and
# frontend/.gitignore — the anchored paths below only make sense at the root.
*.log
.DS_Store
Thumbs.db

.env
.env.backup
.env.production

# API-key exports downloaded from a provider dashboard. Razorpay's are named
# razorpay_test_api_keys_<timestamp>.csv and land wherever the browser saves —
# the repo root, in at least one case. Keep them out of the index.
*api_keys*.csv

/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed

# macOS duplicates. Copying a folder in Finder (or some sync tools) creates a
# sibling named "<name> 2". These have broken the test suite before — duplicate
# migrations register as "table already exists" — and a stray "public/storage 2"
# symlink was committed once, so keep them out of the index entirely.
* [0-9]
* [0-9].*
